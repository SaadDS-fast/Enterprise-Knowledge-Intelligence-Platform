APP_ENV=development
APP_NAME=Enterprise Knowledge Intelligence Platform
APP_VERSION=1.0.0
DEBUG=false
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql+asyncpg://ekip:ekip@postgres:5432/ekip
DATABASE_ECHO=false
AUTO_INIT_DB=false
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
JOB_EXECUTION_MODE=celery
OBJECT_STORAGE_PROVIDER=minio
LOCAL_STORAGE_PATH=/data/storage
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin-change-me
OBJECT_STORAGE_BUCKET=documents
OBJECT_STORAGE_SECURE=false
LLM_PROVIDER=local
LOCAL_LLM_BACKEND=extractive
LOCAL_LLM_BASE_URL=http://ollama:11434
LOCAL_LLM_MODEL=llama3.2:3b
OLLAMA_ENABLED=false
OLLAMA_ALLOWED_MODELS=["llama3.2:3b"]
OLLAMA_ALLOWED_HOSTS=["localhost","127.0.0.1","::1","host.docker.internal","ollama"]
OLLAMA_CONNECT_TIMEOUT_SECONDS=3
OLLAMA_GENERATION_TIMEOUT_SECONDS=45
OLLAMA_MAX_RETRIES=1
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSION=384
SEMANTIC_EMBEDDINGS_ENABLED=false
ANSWER_PASSPORT_ENABLED=false
SEMANTIC_EMBEDDING_PROVIDER=local
SEMANTIC_EMBEDDING_MODEL=
SEMANTIC_EMBEDDING_DIMENSION=384
SEMANTIC_EMBEDDING_BATCH_SIZE=32
SEMANTIC_EMBEDDING_MAX_LENGTH=512
SEMANTIC_EMBEDDING_DEVICE=cpu
SEMANTIC_EMBEDDING_NORMALIZE=true
SEMANTIC_EMBEDDING_FALLBACK_ENABLED=true
SEMANTIC_EMBEDDING_TIMEOUT_SECONDS=30
HYBRID_LEXICAL_WEIGHT=0.45
HYBRID_SEMANTIC_WEIGHT=0.55
RERANKER_ENABLED=false
RERANKER_BLEND_WEIGHT=0.25
RERANKER_MIN_MARGIN=0.08
RERANKER_PROVIDER=local
RERANKER_MODEL=
RERANKER_TOP_N=20
RERANKER_RETURN_K=8
RERANKER_MAX_LENGTH=512
RERANKER_DEVICE=cpu
RERANKER_FALLBACK_ENABLED=true
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1,backend
MAX_REQUEST_BODY_BYTES=31457280
INGESTION_STAGE_DELAY_SECONDS=0
MAX_UPLOAD_BYTES=26214400
REQUIRE_MALWARE_SCAN=false
OTEL_ENABLED=false
OTEL_SERVICE_NAME=ekip-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
METRICS_ENABLED=true
ANSWER_PASSPORT_ENABLED=false
ANSWER_PASSPORT_PERSISTENCE_ENABLED=false
ANSWER_PASSPORT_EXPORT_ENABLED=false
AGENTIC_RAG_ENABLED=false
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS=8
AGENT_TIMEOUT_SECONDS=90
AGENT_MAX_RETRIEVAL_RETRIES=0
AGENT_PLANNER_PROVIDER=deterministic
AGENT_RESEARCH_ENABLED=false
AGENT_RESEARCH_MAX_STEPS=12
AGENT_RESEARCH_MAX_TOOL_CALLS=20
AGENT_RESEARCH_MAX_SOURCES=20
AGENT_RESEARCH_TIMEOUT_SECONDS=300
AGENT_RESEARCH_MAX_REPORT_WORDS=5000
AGENT_RESEARCH_MAX_CONCURRENT_PER_USER=3
AGENT_RESEARCH_MAX_CONCURRENT_PER_WORKSPACE=10
AGENT_RESEARCH_MAX_QUEUED_JOBS=100
AGENT_RESEARCH_STAGE_DELAY_SECONDS=0
AGENT_RESEARCH_EXTERNAL_SOURCES_DEFAULT=false
AGENT_RESEARCH_ALLOWED_FORMATS=markdown,pdf,docx
AGENT_RESEARCH_SIGNED_URL_TTL_SECONDS=600
AGENT_WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=disabled
SEARXNG_URL=http://searxng:8080
SEARXNG_SECRET=ekip-local-validation-key-change-me
WEB_SEARCH_MAX_RESULTS=5
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_AGENTIC_RAG_ENABLED=false
NEXT_PUBLIC_AGENTIC_RESEARCH_ENABLED=false
NEXT_PUBLIC_AGENT_EXTERNAL_SOURCES_ENABLED=false
NEXT_PUBLIC_AGENT_POLL_INTERVAL_MS=2000

# For lightweight local development without Docker, override:
# DATABASE_URL=sqlite+aiosqlite:///./ekip.db
# JOB_EXECUTION_MODE=inline
# OBJECT_STORAGE_PROVIDER=local
# LOCAL_STORAGE_PATH=./data/storage
