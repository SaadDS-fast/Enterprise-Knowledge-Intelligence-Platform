APP_ENV=development
APP_NAME=Enterprise Knowledge Intelligence Platform
APP_VERSION=1.0.0
DEBUG=false
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql+asyncpg://ekip:ekip@postgres:5432/ekip
DATABASE_ECHO=false
AUTO_INIT_DB=false
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
JOB_EXECUTION_MODE=celery
OBJECT_STORAGE_PROVIDER=minio
LOCAL_STORAGE_PATH=/data/storage
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin-change-me
OBJECT_STORAGE_BUCKET=documents
OBJECT_STORAGE_SECURE=false
LLM_PROVIDER=local
LOCAL_LLM_BACKEND=extractive
LOCAL_LLM_BASE_URL=http://ollama:11434
LOCAL_LLM_MODEL=llama3.2:3b
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSION=384
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1,backend
MAX_UPLOAD_BYTES=26214400
REQUIRE_MALWARE_SCAN=false
OTEL_ENABLED=false
METRICS_ENABLED=true
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# For lightweight local development without Docker, override:
# DATABASE_URL=sqlite+aiosqlite:///./ekip.db
# JOB_EXECUTION_MODE=inline
# OBJECT_STORAGE_PROVIDER=local
# LOCAL_STORAGE_PATH=./data/storage
